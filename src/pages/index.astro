---
import BaseHead from '../components/BaseHead.astro';
import FloatingContact from '../components/FloatingContact.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import HomeSchema from '../components/HomeSchema.astro';
import About from '../components/sections/About.astro';
import CallToAction from '../components/sections/CallToAction.astro';
import FAQ from '../components/sections/FAQ.astro';
import Hero from '../components/sections/Hero.astro';
import LatestPosts from '../components/sections/LatestPosts.astro';
import Problems from '../components/sections/Problems.astro';
import Process from '../components/sections/Process.astro';
import Projects from '../components/sections/Projects.astro';
import Regions from '../components/sections/Regions.astro';
import Sectors from '../components/sections/Sectors.astro';
import Services from '../components/sections/Services.astro';
import WhyUs from '../components/sections/WhyUs.astro';
import { missingKeys, t } from '../i18n/ar';
import '../styles/home.css';

// تنبيه وقت الـ build لو فيه نصوص لسه ما اتكتبتش
const missing = missingKeys();
if (import.meta.env.PROD && missing.length > 0) {
	console.warn(`[home] ${missing.length} text keys are still empty in src/i18n/ar.ts`);
}
---

<!doctype html>
<html lang="ar" dir="rtl">
	<head>
		<BaseHead title={t('meta.title')} description={t('meta.description')} />
		<HomeSchema />
	</head>
	<body>
		<Header />
		<main class="home">
			<Hero />
			<div class="flow">
				<div class="pipe" aria-hidden="true"><span class="water"></span></div>
				<Services />
				<About />
				<Problems />
				<Process />
				<Projects />
				<WhyUs />
				<Sectors />
				<Regions />
				<LatestPosts />
				<FAQ />
			</div>
			<CallToAction />
		</main>
		<Footer />
		<FloatingContact />
	</body>
</html>

<style>
	.flow {
		position: relative;
	}

	/* الماسورة الرئيسية: بتتملي مياه مع السكرول */
	.pipe {
		position: absolute;
		inset-block: 0;
		inset-inline-start: var(--pipe-x);
		z-index: 1;
		width: var(--pipe-w);
		box-sizing: border-box;
		border-inline: 3px solid var(--pvc);
		background: var(--pvc-dark);
	}
	.water {
		display: block;
		height: 100%;
		background: var(--accent-bright);
		transform-origin: top;
	}

	@supports (animation-timeline: scroll()) {
		@media (prefers-reduced-motion: no-preference) {
			/* خصائص منفصلة: لو اتكتبت shorthand الـ minifier بيدمجها والمتصفح بيرفضها */
			.water {
				animation-name: fill-main;
				animation-timing-function: linear;
				animation-timeline: scroll(root);
			}
		}
	}

	@keyframes fill-main {
		from {
			transform: scaleY(0);
		}
		to {
			transform: scaleY(1);
		}
	}
</style>
