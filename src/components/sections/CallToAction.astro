---
import { PHONE, WHATSAPP, WHATSAPP_MESSAGE } from '../../consts';
import { t } from '../../i18n/ar';

const whatsappURL = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(WHATSAPP_MESSAGE)}`;
---

<section class="cta">
	<div class="wrap">
		<div>
			<h2>{t('cta.title')}</h2>
			<p>{t('cta.text')}</p>
		</div>
		<div class="actions">
			<a class="phone" href={`tel:${PHONE}`} dir="ltr">{PHONE}</a>
			<a class="wa" href={whatsappURL} target="_blank" rel="noopener">{t('cta.whatsapp')}</a>
		</div>
	</div>
</section>

<style>
	.cta {
		background: var(--signal);
		color: var(--ink);
	}
	.wrap {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 2rem clamp(2rem, 6vw, 5rem);
		padding-block: clamp(3rem, 6vw, 5rem);
	}
	h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.9rem, 4vw, 3rem);
		font-weight: 800;
		line-height: 1.25;
		color: var(--ink);
	}
	p {
		margin: 0.6rem 0 0;
		font-size: 1.125rem;
	}
	.actions {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}
	.phone {
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 4.2vw, 3rem);
		font-weight: 800;
		line-height: 1.2;
		color: var(--ink);
		text-decoration: none;
	}
	.phone:hover,
	.wa:hover {
		color: var(--ink);
		text-decoration: underline;
	}
	.wa {
		font-weight: 600;
		color: var(--ink);
	}
	.cta :focus-visible {
		outline-color: var(--ink);
	}
</style>
