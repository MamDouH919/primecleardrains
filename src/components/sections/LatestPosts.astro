---
import { getCollection } from 'astro:content';
import { t } from '../../i18n/ar';
import FormattedDate from '../FormattedDate.astro';
import SectionHead from './SectionHead.astro';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<section id="latest-posts" class="sec sec--tint">
	<div class="wrap">
		<SectionHead name="blog" />
		<ul>
			{
				posts.map((post) => (
					<li>
						<h3>
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
						</h3>
						<p>{post.data.description}</p>
						<small>
							<FormattedDate date={post.data.pubDate} />
						</small>
					</li>
				))
			}
		</ul>
		<a class="all" href="/blog/">{t('blog.all')}</a>
	</div>
</section>

<style>
	ul {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem clamp(1.5rem, 4vw, 3rem);
		margin: 0 0 2rem;
		padding: 0;
		list-style: none;
	}
	/* اللينك على العنوان بس (anchor text قصير)، والكارت كله بيضغط بالـ ::after */
	li {
		position: relative;
		padding-block-start: 0.9rem;
		border-block-start: 2px solid var(--ink);
	}
	h3 a {
		color: inherit;
		text-decoration: none;
	}
	h3 a::after {
		content: '';
		position: absolute;
		inset: 0;
	}
	li:hover h3 {
		color: var(--accent-strong);
		text-decoration: underline;
	}
	li:has(:focus-visible) {
		outline: 3px solid var(--accent-strong);
		outline-offset: 4px;
	}
	h3 a:focus-visible {
		outline: none;
	}
	h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.2rem;
		font-weight: 600;
		line-height: 1.45;
		color: var(--ink);
	}
	p {
		margin: 0.4rem 0;
		color: var(--muted);
	}
	small {
		color: var(--muted);
	}
	.all {
		font-weight: 600;
		color: var(--accent-strong);
	}
	@media (max-width: 800px) {
		ul {
			grid-template-columns: 1fr;
		}
	}
</style>
