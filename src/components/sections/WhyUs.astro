---
import { items, t } from '../../i18n/ar';
import SectionHead from './SectionHead.astro';
---

<section id="why-us" class="sec sec--tint">
	<div class="wrap">
		<SectionHead name="why" />
		<ul>
			{
				items('why.items').map((key) => (
					<li>
						<h3>{t(`${key}.title`)}</h3>
						<p>{t(`${key}.description`)}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	ul {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2.5rem clamp(1.5rem, 4vw, 3.5rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	h3 {
		margin: 0;
		padding-block-start: 0.9rem;
		border-block-start: 3px solid var(--accent-strong);
		font-family: var(--font-display);
		font-size: 1.2rem;
		font-weight: 600;
		line-height: 1.4;
		color: var(--ink);
	}
	p {
		margin: 0.4rem 0 0;
		color: var(--muted);
	}
	@media (max-width: 900px) {
		ul {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 560px) {
		ul {
			grid-template-columns: 1fr;
		}
	}
</style>
