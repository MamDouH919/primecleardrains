---
import { t } from '../../i18n/ar';
import { getProjects } from '../../lib/projects';
import ProjectCard from '../projects/ProjectCard.astro';
import SectionHead from './SectionHead.astro';

// أول 5 مشاريع في شبكة "bento": الأول كبير والباقي حواليه. لو مفيش مشاريع القسم بيختفي
const projects = (await getProjects()).slice(0, 5);
---

{
	projects.length > 0 && (
		<section id="projects" class="sec sec--dark">
			<div class="wrap">
				<SectionHead name="projects" />
				<div class:list={['bento', `bento--${projects.length}`]}>
					{projects.map((project, i) => (
						<ProjectCard project={project} large={i === 0} />
					))}
				</div>
				<a class="btn btn--ghost all" href="/projects/">
					{t('projects.all')}
				</a>
			</div>
		</section>
	)
}

<style>
	.sec {
		scroll-margin-block-start: 4rem;
	}
	.bento {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		grid-auto-rows: clamp(180px, 20vw, 250px);
		gap: 14px;
	}
	.bento > :global(.card) {
		min-height: 0;
	}
	.bento > :global(.card:first-child) {
		grid-column: span 2;
		grid-row: span 2;
	}
	/* عدد أقل من 5: الكروت بتملا المساحة بدل ما يفضل فراغ */
	.bento--1 > :global(.card:first-child) {
		grid-column: 1 / -1;
	}
	.bento--2 > :global(.card:nth-child(2)),
	.bento--3 > :global(.card:nth-child(n + 2)) {
		grid-column: span 2;
	}
	.bento--2 > :global(.card:nth-child(2)) {
		grid-row: span 2;
	}
	.bento--4 > :global(.card:nth-child(4)) {
		grid-column: span 2;
	}
	.all {
		margin-block-start: 2rem;
	}
	@media (max-width: 820px) {
		.bento {
			grid-template-columns: 1fr 1fr;
		}
		.bento > :global(.card:first-child),
		.bento--4 > :global(.card:nth-child(4)) {
			grid-column: 1 / -1;
			grid-row: span 2;
		}
		.bento--2 > :global(.card:nth-child(2)),
		.bento--3 > :global(.card:nth-child(n + 2)) {
			grid-column: span 1;
			grid-row: span 1;
		}
		.bento--2 > :global(.card:nth-child(2)) {
			grid-column: 1 / -1;
		}
	}
	@media (max-width: 520px) {
		.bento {
			grid-template-columns: 1fr;
		}
		.bento > :global(.card) {
			grid-column: auto !important;
			grid-row: auto !important;
			aspect-ratio: 4 / 3;
		}
		.all {
			width: 100%;
		}
	}
</style>
