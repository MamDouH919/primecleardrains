---
import { items, t } from '../../i18n/ar';
import SectionHead from './SectionHead.astro';

// الأيقونات بالترتيب، ولو الخدمات زادت عن عدد الأيقونات بتتكرر
const icons = [
	'M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z',
	'M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2M15 18H9M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 17.52 8H14M5 18a2 2 0 1 0 4 0a2 2 0 1 0-4 0M15 18a2 2 0 1 0 4 0a2 2 0 1 0-4 0',
	'M3 5a9 3 0 1 0 18 0a9 3 0 1 0-18 0M3 5v14a9 3 0 0 0 18 0V5M3 12a9 3 0 0 0 18 0',
	'M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3zM9 13a3 3 0 1 0 6 0a3 3 0 1 0-6 0',
	'M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z',
	'M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18zM6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2M10 6h4M10 10h4M10 14h4M10 18h4',
	'M2 21h20M2 21v-4h5v-4h5V9h5V5h5v16M12 3v4M10 5l2 2 2-2',
];
---

<section id="services" class="sec">
	<div class="wrap">
		<SectionHead name="services" />
		<ul class="list">
			{
				items('services.items').map((key, i) => (
					<li>
						<svg
							viewBox="0 0 24 24"
							width="34"
							height="34"
							fill="none"
							stroke="currentColor"
							stroke-width="1.6"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d={icons[i % icons.length]} />
						</svg>
						<div>
							<h3>{t(`${key}.title`)}</h3>
							<p>{t(`${key}.description`)}</p>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.sec {
		scroll-margin-block-start: 4rem;
	}
	.list {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		column-gap: clamp(2rem, 5vw, 4.5rem);
		margin: 0;
		padding: 0;
		list-style: none;
		border-block-start: 2px solid var(--ink);
	}
	li {
		display: flex;
		gap: 1.25rem;
		padding-block: 1.75rem;
		border-block-end: 1px solid var(--line);
	}
	svg {
		flex: none;
		margin-block-start: 0.2rem;
		color: var(--accent-strong);
	}
	h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.3rem;
		font-weight: 600;
		line-height: 1.4;
		color: var(--ink);
	}
	p {
		margin: 0.4rem 0 0;
		color: var(--muted);
	}
	@media (max-width: 720px) {
		.list {
			grid-template-columns: 1fr;
		}
	}
</style>
