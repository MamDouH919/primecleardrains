---
import { items, t } from '../../i18n/ar';
import SectionHead from './SectionHead.astro';
---

<section id="process" class="sec">
	<div class="wrap">
		<SectionHead name="process" />
		<ol>
			{
				items('process.items').map((key) => (
					<li>
						<h3>{t(`${key}.title`)}</h3>
						<p>{t(`${key}.description`)}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	ol {
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: minmax(0, 1fr);
		gap: 2rem;
		margin: 0;
		padding: 0;
		list-style: none;
		counter-reset: step;
	}
	li {
		position: relative;
		padding-block-start: 4.25rem;
		counter-increment: step;
	}
	/* الخط اللي بيربط الخطوات */
	li::before {
		content: '';
		position: absolute;
		inset-block-start: 1.45rem;
		inset-inline: 0 -2rem;
		height: 6px;
		background: var(--pvc);
	}
	li:last-child::before {
		inset-inline-end: 0;
	}
	li::after {
		content: counter(step);
		position: absolute;
		inset-block-start: 0;
		inset-inline-start: 0;
		display: grid;
		place-items: center;
		width: 3.25rem;
		height: 3.25rem;
		border-radius: 50%;
		background: var(--accent-strong);
		color: #fff;
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 700;
		line-height: 1;
	}
	h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.2rem;
		font-weight: 600;
		line-height: 1.4;
		color: var(--ink);
	}
	p {
		margin: 0.4rem 0 0;
		color: var(--muted);
	}
	@media (max-width: 900px) {
		ol {
			grid-auto-flow: row;
			gap: 0;
		}
		li {
			padding-block: 0 2.25rem;
			padding-inline-start: 4.25rem;
		}
		li::before {
			inset-block: 0;
			inset-inline: 1.45rem auto;
			width: 6px;
			height: auto;
		}
		li:last-child::before {
			display: none;
		}
	}
</style>
