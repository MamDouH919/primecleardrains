---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { items, t } from '../../i18n/ar';
import SectionHead from './SectionHead.astro';

// صورة اختيارية: حط صورة شغل حقيقية باسم about في src/assets/home وهتظهر لوحدها
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/home/about.{webp,jpg,jpeg,png}', {
	eager: true,
});
const photo = Object.values(images)[0]?.default;
---

<section id="about" class="sec sec--tint">
	<div class="wrap">
		<SectionHead name="about" />
		<div class="grid">
			<div class="text">
				{
					items('about.sections').map((key) => (
						<>
							<h3>{t(`${key}.title`)}</h3>
							<p>{t(`${key}.body`)}</p>
						</>
					))
				}
			</div>
			<aside>
				{photo && <Image src={photo} alt={t('about.image.alt')} widths={[400, 800]} sizes="(max-width: 900px) 100vw, 400px" />}
				<h3>{t('about.points.title')}</h3>
				<ul>
					{
						items('about.points')
							.filter((key) => key !== 'about.points.title')
							.map((key) => <li>{t(key)}</li>)
					}
				</ul>
			</aside>
		</div>
	</div>
</section>

<style>
	.grid {
		display: grid;
		grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
		gap: clamp(2rem, 6vw, 5rem);
		align-items: start;
	}
	.text {
		max-width: 42rem;
	}
	h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.3rem;
		font-weight: 600;
		line-height: 1.4;
		color: var(--ink);
	}
	.text p {
		margin: 0.6rem 0 2rem;
	}
	.text p:last-child {
		margin-block-end: 0;
	}
	aside {
		padding-inline-start: clamp(1.25rem, 3vw, 2rem);
		border-inline-start: 4px solid var(--accent-strong);
	}
	aside img {
		display: block;
		width: 100%;
		margin-block-end: 1.5rem;
		border-radius: 4px;
	}
	ul {
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
	}
	li {
		padding-block: 0.7rem;
		border-block-start: 1px solid var(--line);
	}
	@media (max-width: 900px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
