---
import { PHONE, WHATSAPP, WHATSAPP_MESSAGE } from '../consts';
import { items, t } from '../i18n/ar';

const today = new Date();
const whatsappURL = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(WHATSAPP_MESSAGE)}`;
---

<footer>
	<div class="columns">
		<div class="about">
			<p class="name">{t('site.name')}</p>
			<p>{t('footer.about')}</p>
		</div>
		<div>
			<p class="col-title">{t('footer.services.title')}</p>
			<ul>
				{
					items('services.items').map((key) => (
						<li>
							<a href="/#services">{t(`${key}.title`)}</a>
						</li>
					))
				}
			</ul>
		</div>
		<div>
			<p class="col-title">{t('footer.areas.title')}</p>
			<ul>
				{
					items('areas.items')
						.slice(0, 6)
						.map((key) => (
							<li>
								<a href="/#areas">{t(key)}</a>
							</li>
						))
				}
			</ul>
		</div>
		<address>
			<p class="col-title">{t('footer.contact.title')}</p>
			<dl>
				<dt>{t('footer.phone.label')}</dt>
				<dd><a href={`tel:${PHONE}`} dir="ltr">{PHONE}</a></dd>
				<dt>{t('footer.whatsapp.label')}</dt>
				<dd><a href={whatsappURL} target="_blank" rel="noopener" dir="ltr">+{WHATSAPP}</a></dd>
				<dt>{t('footer.address.label')}</dt>
				<dd>{t('footer.address')}</dd>
				<dt>{t('footer.hours.label')}</dt>
				<dd>{t('footer.hours')}</dd>
			</dl>
		</address>
	</div>
	<p class="rights">&copy; {today.getFullYear()} {t('footer.rights')}</p>
</footer>

<style>
	footer {
		padding: clamp(3rem, 6vw, 4.5rem) 18px 7rem;
		background: var(--ink);
		color: var(--on-ink);
		font-size: 1rem;
		line-height: 1.7;
	}
	.columns {
		display: grid;
		grid-template-columns: 1.5fr 1fr 1fr 1.3fr;
		gap: 2.5rem clamp(1.5rem, 4vw, 3rem);
		max-width: 1164px;
		margin-inline: auto;
	}
	.name {
		margin: 0 0 0.5rem;
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 700;
		color: #fff;
	}
	.about p:last-child {
		margin: 0;
	}
	/* عناوين الأعمدة مش headings عشان ما تتكررش مع عناوين أقسام الصفحة */
	.col-title {
		margin: 0 0 0.75rem;
		font-family: var(--font-display);
		font-size: 1.05rem;
		font-weight: 600;
		line-height: 1.4;
		color: #fff;
	}
	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	li {
		padding-block: 0.15rem;
	}
	a {
		color: inherit;
		text-decoration: none;
	}
	a:hover {
		color: #fff;
		text-decoration: underline;
	}
	a:focus-visible {
		outline: 3px solid var(--signal);
		outline-offset: 2px;
	}
	address {
		font-style: normal;
	}
	dl {
		margin: 0;
	}
	dt {
		font-size: 0.875rem;
		opacity: 0.75;
	}
	dd {
		margin: 0 0 0.6rem;
		color: #fff;
	}
	.rights {
		max-width: 1164px;
		margin: 2.5rem auto 0;
		padding-block-start: 1.25rem;
		border-block-start: 1px solid rgb(255 255 255 / 18%);
		font-size: 0.875rem;
	}
	@media (max-width: 900px) {
		.columns {
			grid-template-columns: repeat(2, 1fr);
		}
		.about {
			grid-column: 1 / -1;
		}
	}
	@media (max-width: 480px) {
		.columns {
			grid-template-columns: 1fr;
		}
	}
</style>
