---
import { PHONE } from '../consts';
import { t } from '../i18n/ar';
import HeaderLink from './HeaderLink.astro';
import { Image } from 'astro:assets';
import logo from '../assets/logo.webp';
---

<header>
	<nav aria-label={t('nav.menu_label')}>
		<a class="brand" href="/" aria-label={t('site.name')}>
			<Image src={logo} alt={t('site.name')} height={48} densities={[1, 2]} loading="eager" fetchpriority="high" />
		</a>
		<div class="links">
			<HeaderLink href="/">{t('nav.home')}</HeaderLink>
			<HeaderLink href="/#services">{t('nav.services')}</HeaderLink>
			<HeaderLink href="/projects">{t('nav.projects')}</HeaderLink>
			<HeaderLink href="/#areas">{t('nav.areas')}</HeaderLink>
			<HeaderLink href="/blog">{t('nav.blog')}</HeaderLink>
			<HeaderLink href="/about">{t('nav.about')}</HeaderLink>
		</div>
		<a class="call" href={`tel:${PHONE}`}>{t('nav.call')}</a>
	</nav>
</header>

<style>
	header {
		position: sticky;
		inset-block-start: 0;
		z-index: 50;
		background: #fff;
		border-block-end: 1px solid var(--line);
		font-size: 1rem;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		max-width: 1200px;
		min-height: 64px;
		margin-inline: auto;
		padding-inline: 18px;
		box-sizing: border-box;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		flex-shrink: 0;
	}
	.brand img {
		display: block;
		width: auto;
		height: 48px;
	}
	.links {
		display: flex;
		gap: 0.25rem 1.25rem;
	}
	.links :global(a) {
		padding-block: 0.4rem;
		color: var(--ink);
		text-decoration: none;
		white-space: nowrap;
	}
	.links :global(a:hover) {
		color: var(--accent-strong);
		text-decoration: underline;
	}
	.call {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0.25rem 1.25rem;
		border-radius: 999px;
		background: var(--signal);
		color: var(--ink);
		font-family: var(--font-display);
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
	}
	.call:hover {
		color: var(--ink);
		background: color-mix(in srgb, var(--signal), white 25%);
	}
	/* في الموبايل اللينكات بتنزل صف لوحدها وبتتسحب بالعرض */
	@media (max-width: 820px) {
		nav {
			flex-wrap: wrap;
			padding-block-start: 0.5rem;
		}
		.links {
			order: 3;
			width: 100%;
			overflow-x: auto;
			scrollbar-width: none;
			padding-block-end: 0.25rem;
		}
	}
</style>
