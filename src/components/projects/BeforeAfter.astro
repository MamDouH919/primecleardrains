---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { t } from '../../i18n/ar';

interface Props {
	before: ImageMetadata;
	after: ImageMetadata;
	title: string;
}

// سلايدر مقارنة: "قبل" على اليمين و"بعد" على الشمال، والمقبض بيتسحب بينهم.
// الصورتين في الـ HTML بـ alt واضح، فجوجل بيشوفهم حتى من غير JavaScript.
const { before, after, title } = Astro.props;
const widths = [640, 1000, 1400];
const sizes = '(max-width: 1100px) 100vw, 1060px';
---

<figure class="ba" dir="ltr" style={`aspect-ratio: ${after.width} / ${after.height}`}>
	<Image src={after} alt={`${title} — ${t('projects.after')}`} widths={widths} sizes={sizes} class="img" draggable="false" />
	<Image src={before} alt={`${title} — ${t('projects.before')}`} widths={widths} sizes={sizes} class="img before" draggable="false" />
	<span class="label label--after" aria-hidden="true">{t('projects.after')}</span>
	<span class="label label--before" aria-hidden="true">{t('projects.before')}</span>
	<span class="handle" aria-hidden="true">
		<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
			<path d="M9 6l-6 6 6 6M15 6l6 6-6 6"></path>
		</svg>
	</span>
	<input type="range" min="0" max="100" value="50" aria-label={t('projects.compare')} />
</figure>

<script>
	document.querySelectorAll<HTMLElement>('.ba').forEach((ba) => {
		const range = ba.querySelector('input')!;
		const update = () => ba.style.setProperty('--pos', `${range.value}%`);
		range.addEventListener('input', update);

		// السحب بالماوس أو اللمس في أي مكان على الصورة (الـ range للكيبورد)
		const moveTo = (clientX: number) => {
			const rect = ba.getBoundingClientRect();
			range.value = String(Math.round(((clientX - rect.left) / rect.width) * 100));
			update();
		};
		ba.addEventListener('pointerdown', (e) => {
			ba.setPointerCapture(e.pointerId);
			moveTo(e.clientX);
		});
		ba.addEventListener('pointermove', (e) => {
			if (ba.hasPointerCapture(e.pointerId)) moveTo(e.clientX);
		});
		update();
	});
</script>

<style>
	.ba {
		--pos: 50%;
		position: relative;
		overflow: hidden;
		max-height: 80vh;
		width: 100%;
		margin: 0;
		border-radius: 14px;
		background: var(--ink);
		user-select: none;
		-webkit-user-select: none;
		-webkit-touch-callout: none;
	}
	.ba :global(.img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
		pointer-events: none;
		-webkit-user-drag: none;
	}
	.ba :global(.before) {
		clip-path: inset(0 0 0 var(--pos));
	}
	.label {
		position: absolute;
		inset-block-start: 14px;
		padding: 0.15rem 0.85rem;
		border-radius: 999px;
		background: rgb(2 18 13 / 70%);
		color: #fff;
		font-family: var(--font-display);
		font-size: 0.9rem;
		font-weight: 600;
		pointer-events: none;
	}
	.label--after {
		left: 14px;
	}
	.label--before {
		right: 14px;
		background: var(--signal);
		color: var(--ink);
	}
	/* الخط اللي بيفصل الصورتين والمقبض اللي في نصه */
	.handle {
		position: absolute;
		inset-block: 0;
		left: var(--pos);
		width: 3px;
		translate: -50% 0;
		background: #fff;
		box-shadow: 0 0 12px rgb(0 0 0 / 40%);
		pointer-events: none;
	}
	.handle svg {
		position: absolute;
		top: 50%;
		left: 50%;
		translate: -50% -50%;
		box-sizing: content-box;
		padding: 11px;
		border-radius: 50%;
		background: #fff;
		color: var(--ink);
		box-shadow: 0 4px 16px rgb(0 0 0 / 35%);
	}
	/* الـ range شفاف فوق الصورة كلها: أي سحب في أي مكان بيحرك المقارنة */
	input {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		margin: 0;
		opacity: 0;
		pointer-events: none;
	}
	.ba {
		cursor: ew-resize;
		touch-action: pan-y;
	}
	.ba:has(input:focus-visible) .handle svg {
		outline: 3px solid var(--signal);
		outline-offset: 2px;
	}
</style>
