---
import { Image } from 'astro:assets';
import { t } from '../../i18n/ar';
import { type Project, projectImages, projectUrl } from '../../lib/projects';

interface Props {
	project: Project;
	/** الكارت الكبير: صورة أوضح */
	large?: boolean;
	headingLevel?: 'h2' | 'h3';
}

const { project, large = false, headingLevel: Heading = 'h3' } = Astro.props;
const { title, cover, coverAlt, service, area } = project.data;
const count = projectImages(project).length;
---

<article class:list={['card', { 'card--large': large }]}>
	<Image
		src={cover}
		alt={coverAlt}
		widths={large ? [480, 800, 1200] : [400, 640]}
		sizes={large ? '(max-width: 720px) 100vw, 60vw' : '(max-width: 720px) 100vw, 30vw'}
		loading="lazy"
	/>
	<div class="info">
		<span class="tag">{area}</span>
		<Heading class="title">
			<a href={projectUrl(project)}>{title}</a>
		</Heading>
		<p class="meta">
			{service}
			{
				count > 1 && (
					<span class="count" title={`${count} ${t('projects.photos')}`}>
						<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3zM9 13a3 3 0 1 0 6 0a3 3 0 1 0-6 0" />
						</svg>
						{count}
						<span class="sr-only">{t('projects.photos')}</span>
					</span>
				)
			}
		</p>
	</div>
</article>

<style>
	.card {
		position: relative;
		overflow: hidden;
		min-height: 260px;
		border-radius: 14px;
		background: var(--ink);
		isolation: isolate;
	}
	.card img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
		transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	/* تدرج غامق تحت النص عشان يتقري فوق أي صورة */
	.card::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgb(2 18 13 / 88%) 0%, rgb(2 18 13 / 35%) 45%, transparent 70%);
	}
	.info {
		position: absolute;
		inset-inline: 0;
		inset-block-end: 0;
		z-index: 1;
		padding: 1.1rem 1.25rem 1.2rem;
		color: var(--on-ink);
	}
	.tag {
		display: inline-block;
		padding: 0.1rem 0.7rem;
		border-radius: 999px;
		background: var(--signal);
		color: var(--ink);
		font-size: 0.8rem;
		font-weight: 600;
	}
	.title {
		margin: 0.5rem 0 0;
		font-family: var(--font-display);
		font-size: 1.15rem;
		font-weight: 600;
		line-height: 1.45;
	}
	.card--large .title {
		font-size: clamp(1.3rem, 2.4vw, 1.75rem);
	}
	.title a {
		color: #fff;
		text-decoration: none;
	}
	/* الكارت كله بيضغط من غير ما نلف الـ article في لينك */
	.title a::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 2;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0 0.75rem;
		margin: 0.25rem 0 0;
		font-size: 0.9rem;
	}
	.count {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		opacity: 0.8;
	}
	.card:hover img {
		transform: scale(1.05);
	}
	.card:hover .title a {
		text-decoration: underline;
	}
	.card:has(:focus-visible) {
		outline: 3px solid var(--signal);
		outline-offset: 3px;
	}
	.title a:focus-visible {
		outline: none;
	}
	@media (prefers-reduced-motion: reduce) {
		.card img {
			transition: none;
		}
	}
</style>
