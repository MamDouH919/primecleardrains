---
import { PHONE, WHATSAPP, WHATSAPP_MESSAGE } from '../consts';
import { t } from '../i18n/ar';

const whatsappURL = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(WHATSAPP_MESSAGE)}`;
---

<div class="floating">
	<a class="whatsapp" href={whatsappURL} target="_blank" rel="noopener" aria-label={t('floating.whatsapp')}>
		<svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
			<path
				fill="currentColor"
				d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35zM12.05 21.5h-.01a9.4 9.4 0 0 1-4.8-1.32l-.34-.2-3.57.94.95-3.48-.22-.36a9.43 9.43 0 1 1 7.99 4.42zm8.02-17.45A11.25 11.25 0 0 0 12.05.75C5.82.75.75 5.82.75 12.05c0 1.99.52 3.94 1.51 5.65L.65 23.25l5.68-1.49a11.3 11.3 0 0 0 5.72 1.46c6.23 0 11.3-5.07 11.3-11.3 0-3.02-1.17-5.86-3.3-7.99z"
			></path>
		</svg>
	</a>
	<a class="call" href={`tel:${PHONE}`} aria-label={t('floating.call')}>
		<svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
			<path
				fill="currentColor"
				d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1.02l-2.2 2.2z"
			></path>
		</svg>
	</a>
</div>

<style>
	.floating {
		position: fixed;
		bottom: 1.2em;
		inset-inline-start: 1.2em;
		display: flex;
		flex-direction: column;
		gap: 0.6em;
		z-index: 100;
	}
	.floating a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 56px;
		height: 56px;
		border-radius: 50%;
		color: white;
		box-shadow: 0 4px 12px rgba(var(--black), 25%);
	}
	.floating a:hover {
		transform: scale(1.05);
	}
	.floating a:focus-visible {
		outline: 3px solid var(--ink);
		outline-offset: 3px;
	}
	.whatsapp,
	.whatsapp:hover {
		background: #25d366;
		color: #06301c;
	}
	.call,
	.call:hover {
		background: var(--signal);
		color: var(--ink);
	}
</style>
